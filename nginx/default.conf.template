server {
    listen 80;
    server_name _;

    # The instance (mounted at ${INSTANCE_DIR}): oxid-config.yaml, public/ overlay, plugins/
    # See docs/instance-configuration.md

    # The browser's instance configuration: oxid-config.json, RENDERED at container start from the
    # instance's oxid-config.yaml (allow-list + secret guard, scripts/public-config.mjs). Never cached,
    # so a redeployed config applies on the next load.
    location = /oxid-config.json {
        alias /var/lib/oxid-fe/oxid-config.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    # The deployment YAML is NEVER served — not at its own path, not from the public/ overlay
    location ~* \.ya?ml(\.dist)?$ {
        return 404;
    }

    # external plugins of this instance (ES modules)
    location /plugins/ {
        alias ${INSTANCE_DIR}/plugins/;
        add_header Cache-Control "no-cache";
    }

    # Same-origin GraphQL: the app never does CORS
    location /graphql/ {
        proxy_pass ${API_UPSTREAM}/graphql/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Product images generated by the shop
    location /out/pictures/ {
        proxy_pass ${API_UPSTREAM}/out/pictures/;
        proxy_set_header Host $host;
    }

    # The instance's public/ overlay wins over the compiled app (robots.txt, favicon, images…)
    location / {
        root ${INSTANCE_DIR}/public;
        try_files $uri @app;
    }

    # The compiled app, SPA history fallback
    location @app {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
