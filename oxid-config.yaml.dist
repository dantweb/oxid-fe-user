# oxid-config.yaml — per-INSTANCE configuration of one oxid-fe-user deployment.
#
# Copy to `oxid-config.yaml` (gitignored in dev) or mount the instance's own file at
# /etc/oxid-fe-instance/oxid-config.yaml in the container. One compiled bundle serves any
# number of instances (shop1.oxid.dev, shop2.oxid.dev, ...): only this file and the instance's
# optional `public/` and `plugins/` folders differ. Full reference: docs/instance-configuration.md
#
# !! This file is NEVER served. The browser gets /oxid-config.json, rendered from it (allow-list:
# !! instance, shop.graphql_url, i18n, theme, plugins.*.enabled/source/config). Everything under
# !! plugins.*.config is PUBLIC: no secrets there — the renderer refuses secret-looking keys/values. !!

# Identity — shown as the shop name in header, footer, page titles
instance:
  id: default
  name: OXID Storefront

# The shop's GraphQL endpoint as the BROWSER reaches it. Keep it same-origin (the container's
# nginx proxies /graphql/ to API_UPSTREAM) — a cross-origin URL needs CORS on the shop.
shop:
  graphql_url: /graphql/

# Languages of this instance. Bundled catalogs: en, de.
i18n:
  default_locale: en
  fallback_locale: en
  locales: [en, de] # more than one -> a language switcher appears in the header

# Theme of this instance (resources/themes/<id>/, see docs/theming.md).
#   default: fallback theme, used when `active` cannot be loaded
#   active:  the theme this instance runs (omit = the default)
theme:
  default: default
  active: default

# Plugins of this instance. Key = plugin name.
#   enabled: false            -> not loaded (no routes, no nav entry)
#   source: bundled (default) -> compiled into the app bundle
#   source: external          -> ES module loaded at runtime from <instance>/plugins/<name>/index.js
#   config: {...}             -> merged over the plugin's defaultConfig
plugins:
  shop:
    enabled: true
    config:
      products_per_page: 12
  checkout:
    enabled: true
  # Provider keys (Stripe publishable key, PayPal client id, Mollie profile id) are NOT configured
  # here: the shop hands them over sealed at checkout time (docs/payments-keys.md). A key field in a
  # payment plugin's config stops the build.
  payment-paypal:
    enabled: true
    config:
      mode: iframe # iframe (Smart Buttons, default) | redirect (PayPal's approval page)
      currency: EUR
      intent: capture # shop capture mode automatic -> capture, manual -> authorize
  payment-stripe:
    enabled: true
    config:
      mode: iframe # iframe (inline, default) | redirect (Stripe's hosted page)
  payment-mollie:
    enabled: true
    config:
      mode: iframe
      locale: en_US
      methods: [creditcard, ideal, bancontact]
  dashboard:
    enabled: true
  # Layout plugins (docs/layout-plugins.md) override the header, footer and front page. Opt in:
  # list it LAST so it wins its slots; it brings its own theme unless `theme.active` is set.
  #peroxid:
  #  config:
  #    streams:
  #      - { id: new, type: action, ref: oxnewest }
  #      - { id: sales, type: action, ref: oxbargain }
  #      - { id: electronic, type: category, ref: <category id> }
