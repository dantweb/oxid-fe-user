{
  "name": "@dantweb/oxid-fe-user",
  "version": "0.3.3",
  "description": "Standalone Vue 3 storefront for headless OXID eShop — plugin-host app on @dantweb/oxid-fe-core.",
  "license": "BUSL-1.1",
  "private": true,
  "exports": {
    "./bootstrap": "./src/bootstrap.ts",
    "./plugins/*": "./plugins/*/index.ts",
    "./plugin-components/*": "./plugins/*",
    "./theme-tools": "./scripts/theme-build.mjs",
    "./public-config": "./scripts/public-config.mjs",
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:payments": "playwright test payments- --project=chromium --workers=1",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "evaluate": "node scripts/evaluate.mjs",
    "build:seo": "npm run build && node scripts/generate-sitemap.mjs && node scripts/prerender.mjs",
    "build:themes": "node scripts/build-themes.mjs",
    "watch:themes": "node scripts/build-themes.mjs --watch",
    "predev": "npm run build:themes",
    "prebuild": "npm run build:themes"
  },
  "dependencies": {
    "@dantweb/oxid-fe-core": "file:../oxid-fe-core",
    "@fontsource/roboto": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "knip": "^6.41.0",
    "less": "^4.9.1",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
